  "subtitle": "Amendments to the identity framework, second reading",
  "date": "2026-05-14",
  "voteRule": "simple-majority",
  "voteRuleLabel": "Majority of votes cast",
  "procedure": {
    "reference": "2025/0177(COD)",
    "url": null
  },
  "summary": "Parliament backed the amended framework for a Union-wide digital identity wallet, adding an explicit ban on tracking users across the services they sign into. The privacy safeguards split the Greens and the Left from the centre.",
  "whatItMeans": [
    "Member states must offer a wallet within 24 months; using one stays voluntary for citizens.",
    "Providers may not log which services a person signs into.",
    "Large platforms must accept the wallet where they already require identity verification."
  ],
  "outcome": {
    "result": "adopted",
    "headline": "Adopted — the privacy amendments survived, the timetable did not move."
  },
  "impactUnit": "EUR per person per year",
