{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/volters-cell/We-Volt/schema/decision.schema.json",
  "title": "EU Tracker decision",
  "description": "One Council, Commission or Parliament decision, recorded country by country. See docs/DATA-MODEL.md.",
  "type": "object",
  "required": ["id", "status", "body", "bodyLabel", "title", "date", "summary", "outcome", "sources", "countries"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": { "enum": ["sample", "verified"] },
    "dataNote": { "type": "string" },
    "body": { "enum": ["parliament", "council", "commission"] },
    "bodyLabel": { "type": "string" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "voteRule": { "enum": ["qualified-majority", "simple-majority", "unanimity", "not-a-vote"] },
    "voteRuleLabel": { "type": "string" },
    "procedure": {
      "type": "object",
      "properties": {
        "reference": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "summary": { "type": "string" },
    "whatItMeans": { "type": "array", "items": { "type": "string" } },
    "outcome": {
      "type": "object",
      "required": ["result"],
      "properties": {
        "result": { "type": "string" },
        "headline": { "type": "string" }
      }
    },
    "impactUnit": { "type": "string" },
    "impactLabel": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "countries": {
      "type": "object",
      "description": "Keyed by ISO 3166-1 alpha-2 code, Greece as GR. All 27 member states must be present.",
      "propertyNames": {
        "enum": ["AT", "BE", "BG", "CY", "CZ", "DE", "DK", "EE", "ES", "FI", "FR", "GR", "HR",
                 "HU", "IE", "IT", "LT", "LU", "LV", "MT", "NL", "PL", "PT", "RO", "SE", "SI", "SK"]
      },
      "additionalProperties": { "$ref": "#/$defs/country" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "sample" } }, "required": ["status"] },
      "then": {
        "required": ["dataNote"],
        "description": "A sample record must say so in the file, not only on the page."
      }
    }
  ],
  "$defs": {
    "vote": { "enum": ["for", "against", "abstain", "absent"] },
    "country": {
      "type": "object",
      "properties": {
        "position": { "enum": ["for", "against", "abstain", "absent", "not-applicable"] },
        "representative": { "type": "string" },
        "mepGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group", "seats", "for", "against", "abstain", "absent"],
            "properties": {
              "group": { "type": "string" },
              "seats": { "type": "integer", "minimum": 0 },
              "for": { "type": "integer", "minimum": 0 },
              "against": { "type": "integer", "minimum": 0 },
              "abstain": { "type": "integer", "minimum": 0 },
              "absent": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "meps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "vote"],
            "properties": {
              "name": { "type": "string" },
              "party": { "type": ["string", "null"] },
              "group": { "type": ["string", "null"] },
              "vote": { "$ref": "#/$defs/vote" },
              "id": { "type": ["integer", "string", "null"] }
            }
          }
        },
        "impact": {
          "type": ["object", "null"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "note": { "type": "string" },
            "sample": { "type": "boolean" },
            "source": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "url": { "type": ["string", "null"] }
              }
            }
          },
          "dependentRequired": { "value": ["note"] }
        },
        "press": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["outlet", "headline", "framing"],
            "properties": {
              "outlet": { "type": "string" },
              "headline": { "type": "string" },
              "excerpt": { "type": "string" },
              "framing": { "enum": ["supportive", "critical", "mixed", "neutral"] },
              "language": { "type": ["string", "null"] },
              "date": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] },
              "sample": { "type": "boolean" }
            }
          }
        },
        "note": { "type": "string" }
      }
    }
  }
}
